# DiscoveryGram configuration.
# Copy to .env and fill in. See docs/CONFIGURATION.md for the full reference.

# =============================================================================
# Telegram (required)
# =============================================================================
TELEGRAM_BOT_TOKEN=
# Comma-separated allow-list. At least one id is required — an empty list would
# expose the bot to everyone. Send /whoami to the bot to discover your id.
TELEGRAM_ALLOWED_USER_IDS=
# Optional: restrict group chats too. Empty means every chat an allowed user writes in.
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_PARSE_MODE=MarkdownV2

# =============================================================================
# NoteDiscovery (required)
# =============================================================================
# Base URL *with port*. From inside Docker, a host instance is host.docker.internal.
NOTEDISCOVERY_URL=http://host.docker.internal:8000
# Optional — an instance may run unauthenticated. Sent as X-API-Key.
NOTEDISCOVERY_API_KEY=
NOTEDISCOVERY_TIMEOUT=30
NOTEDISCOVERY_MAX_RETRIES=3
NOTEDISCOVERY_VERIFY_TLS=true
# rest | mcp. REST is primary: NoteDiscovery's MCP server exposes a strict subset
# of the REST API (no media upload, export, sharing or folder move/rename/delete).
NOTEDISCOVERY_TRANSPORT=rest

# GET /api/search has no server-side default cap, so we always send one.
SEARCH_DEFAULT_LIMIT=50
# Shortest query NoteDiscovery will act on. It is a server constant that the API
# does not expose (2 in 0.31.3); shorter queries are refused locally instead.
SEARCH_MIN_QUERY_LENGTH=2
TREE_CACHE_TTL_S=300
INBOX_PATH=Inbox
AUTO_CREATE_PARENTS=true

# =============================================================================
# MCP subprocess (only when NOTEDISCOVERY_TRANSPORT=mcp)
# =============================================================================
MCP_ENABLED=false
# docker = spawn `docker run` (requires /var/run/docker.sock mounted — root-equivalent
#          host access, opt in deliberately)
# local  = spawn `python -m mcp_server` from a vendored module
MCP_LAUNCH_MODE=docker
MCP_DOCKER_IMAGE=ghcr.io/gamosoft/notediscovery:latest
MCP_STARTUP_TIMEOUT_S=30

# =============================================================================
# LLM router (phase 5)
# =============================================================================
# Failover works on (provider, model) pairs. Each pair is retried
# LLM_RETRIES_PER_MODEL times, then the next MODEL of the same provider is
# tried; only when a provider's models run out does the next provider take
# over. `make check-env` prints the exact ladder your configuration produces.
#
#   LLM_CHAIN_CHAT=groq,ollama with GROQ_MODELS=a,b and OLLAMA_MODELS=c gives:
#   groq/a (x3) -> groq/b (x3) -> ollama/c (x3) -> give up
LLM_CHAIN_CHAT=groq,cerebras,openrouter,ollama
LLM_CHAIN_VISION=gemini,openrouter,ollama

# Retries against the SAME (provider, model) pair before moving to the next model.
LLM_RETRIES_PER_MODEL=3
LLM_BACKOFF_BASE_S=1.0
LLM_REQUEST_TIMEOUT_S=60
LLM_CIRCUIT_FAILURE_THRESHOLD=5
LLM_CIRCUIT_RESET_S=120
# 0 disables the per-user daily cap.
LLM_DAILY_CALL_LIMIT_PER_USER=100

# --- Provider credentials and model preferences -----------------------------
# <P>_MODELS and <P>_VISION_MODELS are ordered, comma-separated lists.
# A provider with no key (except ollama) or no model for the task is skipped,
# and the reason is logged at startup.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODELS=
NVIDIA_VISION_MODELS=

OPENROUTER_API_KEY=
OPENROUTER_MODELS=
OPENROUTER_VISION_MODELS=

GROQ_API_KEY=
GROQ_MODELS=
GROQ_VISION_MODELS=

GEMINI_API_KEY=
GEMINI_MODELS=
GEMINI_VISION_MODELS=

CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODELS=
CLOUDFLARE_VISION_MODELS=

CEREBRAS_API_KEY=
CEREBRAS_MODELS=

MISTRAL_API_KEY=
MISTRAL_MODELS=
MISTRAL_VISION_MODELS=

PUTER_API_KEY=
PUTER_MODELS=

# Ollama needs no key.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODELS=
OLLAMA_VISION_MODELS=

# =============================================================================
# Sessions, cache and limits
# =============================================================================
SESSION_BACKEND=memory
REDIS_URL=
SESSION_TTL_S=3600
RESULTS_PAGE_SIZE=5
TREE_PAGE_SIZE=10
LONG_NOTE_MODE=paged
# Telegram's Bot API caps file downloads at 20 MB.
MAX_UPLOAD_MB=20
DEFAULT_TEXT_ACTION=search

# =============================================================================
# Observability
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
HEALTH_PORT=8080
METRICS_ENABLED=false
